<launch>
<!-- Launch file for Pose Graph Optimization (PGO) demo on KITTI dataset -->
<!-- NOTE: This demo uses RAW KITTI point cloud data (.bin files). -->
<!-- The pose file should contain odometry poses that will be optimized using loop closures. -->

  <arg name="rviz" default="true" />
  <rosparam command="load" file="$(find std_detector)/config/config_pgo.yaml" />
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find std_detector)/rviz_cfg/pgo.rviz" />
  </group>

  <node 
		pkg="std_detector" 
		type="pgo_demo" 
		name="pgo_demo" 
		output="screen" 
	/>
  <!-- Path to folder containing RAW KITTI .bin files -->
  <param name="lidar_path" type="string" value = "/usb/kitti/sequences/00/velodyne/"/>
  <!-- Path to LiDAR odometry pose file for optimization -->
  <param name="pose_path" type="string" value = "/usb2/kitti_bags/lio_pose/kitti00_pose_lio.txt"/>



</launch>